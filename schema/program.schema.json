{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Program",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "state", "name", "funding_type", "administrator", "platform", "reimbursement_available",
    "vendor_approval_required", "student_segments", "school_year", "program_status", "status_verified_date",
    "requires_funded_account_gate", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]{2}-[a-z0-9-]+$" },
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "name": { "$ref": "#/definitions/i18n" },
    "funding_type": { "enum": ["esa", "voucher", "tax_credit"] },
    "administrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] }
      }
    },
    "platform": { "enum": ["classwallet", "odyssey", "step_up", "other"] },
    "reimbursement_available": { "enum": [true, false, "unknown"] },
    "vendor_approval_required": { "type": "boolean" },
    "vendor_approval_source": { "type": ["string", "null"], "format": "uri" },
    "student_segments": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["all", "private_school", "home_education"] }
    },
    "award_amounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment", "amount", "per"],
        "properties": {
          "segment": { "type": "string" },
          "amount": { "type": "number" },
          "per": { "enum": ["student_year"] },
          "family_cap": { "type": "number" }
        }
      }
    },
    "school_year": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "program_status": { "enum": ["active", "settling", "paused", "litigated"] },
    "status_note": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/i18n" }] },
    "status_verified_date": { "type": "string", "format": "date" },
    "who_gets_funds_note": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/i18n" }] },
    "requires_funded_account_gate": { "type": "boolean" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tier", "title", "publisher", "url", "retrieved_at"],
        "properties": {
          "id": { "type": "string" },
          "tier": { "enum": [1, 2, 3, 4] },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "document_date": { "type": ["string", "null"], "format": "date" },
          "retrieved_at": { "type": "string", "format": "date" },
          "sha256": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "es": { "type": "string", "minLength": 1 } }
    }
  }
}
