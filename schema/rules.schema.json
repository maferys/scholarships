{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rules file (one per program)",
  "type": "object",
  "additionalProperties": false,
  "required": ["program", "defaults", "submit_tip", "rules"],
  "properties": {
    "program": { "type": "string" },
    "defaults": { "$ref": "#/definitions/ruleFields" },
    "submit_tip": { "$ref": "#/definitions/i18n" },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/ruleFields" } }
  },
  "definitions": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "es": { "type": "string", "minLength": 1 } }
    },
    "ruleFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string" },
        "segment": { "enum": ["all", "private_school", "home_education"] },
        "status": { "enum": ["allowed", "not_allowed", "conditional"] },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_amount": { "type": "number" },
            "frequency": {
              "type": "object", "additionalProperties": false, "required": ["count", "per_years"],
              "properties": { "count": { "type": "integer" }, "per_years": { "type": "integer" } }
            },
            "pct_of_award_cap": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "requires_approved_vendor": { "type": "boolean" },
            "requires_preapproval": { "type": "boolean" },
            "requires_documentation": { "type": "array", "items": { "type": "string" } },
            "student_requirement": { "enum": ["disability"] }
          }
        },
        "conditions_text": { "$ref": "#/definitions/i18n" },
        "submit_tip": { "$ref": "#/definitions/i18n" },
        "source": { "type": "string" },
        "locator": { "type": "string", "minLength": 1 },
        "quote": { "type": ["string", "null"], "maxLength": 200 },
        "conflict_note": { "type": "string" },
        "effective_from": { "type": "string", "format": "date" },
        "effective_to": { "type": ["string", "null"], "format": "date" },
        "last_verified": { "type": "string", "format": "date" },
        "verified_by": { "type": "string" },
        "review_status": { "enum": ["draft", "reviewed"] }
      }
    }
  }
}
